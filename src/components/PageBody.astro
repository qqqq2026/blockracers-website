---
import { PAGES, UI, INVITE, BETA_URL, mark, u, href, type Lang } from '../data/site';
const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://jefgwbzqpskfvlvkpque.supabase.co';
const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
interface Props { lang: Lang; pageKey: string }
const { lang, pageKey } = Astro.props;
const page = PAGES.find((p) => p.key === pageKey)!;
const c = page.content[lang];
---
<section class="br-hero" style={`background-image:url(${u(page.hero)})`}>
  <div class="hero-inner">
    <h1>{c.title}</h1>
    <p>{c.sub}</p>
    <a class="br-btn br-btn--primary" href={BETA_URL}>{UI[lang].play}</a>
    <p class="cta-note">{UI[lang].testers}</p>
  </div>
  <div class="br-checker"></div>
</section>
{c.account && (
  <section class="block"><div class="wrap">
    <div id="br-account" class="acc" data-lang={lang} data-url={SB_URL} data-key={SB_KEY} data-game={BETA_URL} data-privacy={href(lang, PAGES.find((p) => p.key === 'parents')!.slug[lang])}><p class="acc-note">…</p></div>
    <noscript><p>{lang === 'nl' ? 'Zet JavaScript aan om in te loggen.' : 'Turn on JavaScript to log in.'}</p></noscript>
    <script is:inline src={u('/vendor/supabase.js')}></script>
    <script is:inline src={u('/js/account.js')}></script>
  </div></section>
)}
{c.sections.map((s) => (
  <section class={`block ${s.sky ? 'br-section--sky' : ''}`}>
    <div class="wrap">
      <h2>{s.h}</h2>
      {s.p?.map((t) => <p set:html={mark(t)} />)}
      {s.ul && <ul>{s.ul.map((t) => <li set:html={mark(t)} />)}</ul>}
      {s.gallery && <div class="gallery">{s.gallery.map((g) => <img src={u(`/img/screenshots/${g}.png`)} alt={`BlockRacers screenshot ${g.replace(/^\d+_/, '').replace(/_/g, ' ')}`} loading="lazy" />)}</div>}
      {s.invite && (
        <><p><a class="br-btn br-btn--primary" href={href(lang, 'account')}>{INVITE[lang].btn}</a></p><p class="cta-note">{INVITE[lang].note}</p></>
      )}
      {s.links && <ul>{s.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>}
      {s.download && <p><a class="br-btn br-btn--primary" href={u(s.download.href)} download>{s.download.label}</a></p>}
      {s.soon && <p><button class="br-btn br-btn--primary" type="button" disabled>{UI[lang].soon}</button></p>}
      {s.cta && <><p><a class="br-btn br-btn--primary" href={BETA_URL}>{UI[lang].play}</a></p><p class="cta-note">{UI[lang].testers}</p></>}
    </div>
  </section>
))}
{pageKey === 'studio' && (
  <section class="block"><div class="wrap"><img src={u("/img/logo/studio_wordmark_on_navy.png")} alt="BlockRacers Studio" style="max-width:420px" /></div></section>
)}
