---
import { PAGES, UI, INVITE, BETA_URL, mark, u, type Lang } from '../data/site';
interface Props { lang: Lang; pageKey: string }
const { lang, pageKey } = Astro.props;
const page = PAGES.find((p) => p.key === pageKey)!;
const c = page.content[lang];
---
<section class="br-hero" style={`background-image:url(${u(page.hero)})`}>
  <div class="hero-inner">
    <h1>{c.title}</h1>
    <p>{c.sub}</p>
    <a class="br-btn br-btn--primary" href={BETA_URL}>{UI[lang].play}</a>
    <p class="cta-note">{UI[lang].testers}</p>
  </div>
  <div class="br-checker"></div>
</section>
{c.sections.map((s) => (
  <section class={`block ${s.sky ? 'br-section--sky' : ''}`}>
    <div class="wrap">
      <h2>{s.h}</h2>
      {s.p?.map((t) => <p set:html={mark(t)} />)}
      {s.ul && <ul>{s.ul.map((t) => <li set:html={mark(t)} />)}</ul>}
      {s.gallery && <div class="gallery">{s.gallery.map((g) => <img src={u(`/img/screenshots/${g}.png`)} alt={`BlockRacers screenshot ${g.replace(/^\d+_/, '').replace(/_/g, ' ')}`} loading="lazy" />)}</div>}
      {s.invite && (
        <form class="invite-form" onsubmit="return false" aria-describedby="invite-note">
          <fieldset><legend>{INVITE[lang].q}</legend>
            <label><input type="radio" name="age" value="u16" /> {INVITE[lang].u16}</label>
            <label><input type="radio" name="age" value="o16" /> {INVITE[lang].o16}</label>
          </fieldset>
          <div data-step="u16" hidden><p>{INVITE[lang].parent}</p><label>{INVITE[lang].pmail}<br /><input type="email" autocomplete="off" disabled /></label></div>
          <div data-step="o16" hidden><label>{INVITE[lang].own}<br /><input type="email" autocomplete="off" disabled /></label></div>
          <button class="br-btn br-btn--primary" type="button" disabled id="invite-note">{INVITE[lang].btn}</button>
        </form>
        <script is:inline>document.querySelectorAll('.invite-form input[name=age]').forEach(function(r){r.addEventListener('change',function(){document.querySelectorAll('.invite-form [data-step]').forEach(function(d){d.hidden=d.dataset.step!==r.value})})})</script>
      )}
      {s.cta && <><p><a class="br-btn br-btn--primary" href={BETA_URL}>{UI[lang].play}</a></p><p class="cta-note">{UI[lang].testers}</p></>}
    </div>
  </section>
))}
{pageKey === 'studio' && (
  <section class="block"><div class="wrap"><img src={u("/img/logo/studio_wordmark_on_navy.png")} alt="BlockRacers Studio" style="max-width:420px" /></div></section>
)}
