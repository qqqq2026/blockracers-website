---
import '../styles/brand.css';
import { PAGES, UI, SOCIAL, BETA_URL, SITE_URL, href, u, type Lang } from '../data/site';
interface Props { lang: Lang; pageKey: string; title: string }
const { lang, pageKey, title } = Astro.props;
const ui = UI[lang];
const current = PAGES.find((p) => p.key === pageKey)!;
const other = ui.otherLang;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | BlockRacers</title>
    <meta name="description" content={ui.tagline} />
    <meta property="og:title" content={`${title} | BlockRacers`} />
    <meta property="og:image" content={new URL("/img/og_share_1200x630.png", SITE_URL).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', SITE_URL).href} />
    <link rel="icon" href={u("/img/logo/app_icon.svg")} type="image/svg+xml" />
    <link rel="alternate" hreflang={other} href={href(other, current.slug[other])} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={href(lang, '')} aria-label="BlockRacers, Home"><span class="logo-word" aria-hidden="true">BLOCK<span>RACERS</span></span></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" hidden><span class="nav-toggle-bars" aria-hidden="true"></span><span class="nav-toggle-label">{lang === 'nl' ? 'Menu' : 'Menu'}</span></button>
        <div class="site-menu" id="site-menu">
        <nav class="site-nav" aria-label="Menu">
          {PAGES.filter((p) => p.nav !== false).map((p) => <a href={href(lang, p.slug[lang])} aria-current={p.key === pageKey ? 'page' : undefined}>{p.menu[lang]}</a>)}
        </nav>
        <span class="lang"><a href={href(lang, 'account')} aria-current={pageKey === 'account' ? 'page' : undefined}>{ui.account}</a> <a href={href(other, current.slug[other])} hreflang={other}>{ui.other}</a></span>
        </div>
        <span class="header-cta"><a class="br-btn br-btn--primary" href={BETA_URL}>{ui.play}</a><small class="cta-note">{ui.testers}</small></span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="br-checker"></div>
      <div class="wrap">
        <div><p class="br-label">BlockRacers</p><p>{ui.tagline}</p><p><small>{ui.colofon}</small></p></div>
        <div><p class="br-label">{ui.game}</p><ul>{SOCIAL.game.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}</ul></div>
        <div>
          <p class="br-label">{ui.studio}</p>
          <img src={u("/img/logo/studio_wordmark_on_dark_transparent.png")} alt="BlockRacers Studio" />
          <ul>{SOCIAL.studio.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}</ul>
        </div>
      </div>
    </footer>
    <script is:inline>(function(){var b=document.querySelector('.nav-toggle'),m=document.getElementById('site-menu');if(!b||!m)return;document.documentElement.classList.add('js-nav');b.hidden=false;function set(o){b.setAttribute('aria-expanded',o?'true':'false');m.classList.toggle('is-open',o)}b.addEventListener('click',function(){set(b.getAttribute('aria-expanded')!=='true')});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&b.getAttribute('aria-expanded')==='true'){set(false);b.focus()}});matchMedia('(min-width:900px)').addEventListener('change',function(e){if(e.matches)set(false)})})();</script>
  </body>
</html>
